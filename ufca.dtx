  \vspace*{\baselineskip}
  \begingroup
  \centering
  \noindent\bfseries\MakeUppercase{\local@cityname},
  \local@day\ DE\
  \MakeUppercase{\local@month}\ DE\ \local@year\par
  \endgroup}

