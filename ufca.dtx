%% ------------------------------------------------------------------
%% 6. Interface de dados do usuario
%% ------------------------------------------------------------------
%% Todos os campos sao gravados globalmente com \ufca@set{nome}{valor}
%% e lidos como \local@... , \foreign@... ou \Ufca... .
%% Convencao da interface: comandos em portugues definem os dados em
%% portugues; \title e \keyword definem as versoes estrangeiras.
\newcommand*\ufca@set[2]{\global\@namedef{#1}{#2}}

\newcommand\autor[1]{%
  \ufca@set{@authname}{#1}}
\newcommand\titulo[1]{\ufca@set{local@title}{#1}}
\newcommand\unidadeacademica[1]{\ufca@set{local@unitname}{#1}}
\newcommand\local[1]{\ufca@set{local@cityname}{#1}}
\newcommand\data[3]{%
  \ufca@set{local@day}{#1}%
  \ufca@set{local@month}{#2}%
  \ufca@set{local@year}{#3}}
\newcommand\grau[2]{%
  \ufca@set{local@degreename}{#1}%
  \ufca@set{local@levelname}{#2}}
\newcommand\tipodetrabalho[2][false]{%
  \ifstrequal{#1}{true}{\global\maledoctrue}{\global\maledocfalse}%
  \ufca@set{local@doctype}{#2}}
\newcommand\curso[1]{\ufca@set{local@coursename}{#1}}
\newcommand\programa[1]{%
  \global\posgradtrue
  \ufca@set{local@progname}{#1}}
\newcommand\fichacatalografica[1]{%
  \global\cataloging@filetrue
  \ufca@set{local@catalogingfile}{#1}}

\newcommand\declaracaodevalidacao[1]{%
  \global\validation@filetrue
  \ufca@set{local@validationfile}{#1}}

\newcommand\orientador[4]{%
  \ifstrequal{#1}{F}%
    {\ufca@set{local@advisorgender}{a}}%
    {\ufca@set{local@advisorgender}{}}%
  \ufca@set{local@advisortitle}{#2}%
  \ufca@set{local@advisorname}{#3}%
  \ufca@set{local@advisordegree}{#4}}

\newcount\@coadvisor \@coadvisor=0
\newcommand\coorientador[4]{%
  \global\advance\@coadvisor by 1
  \ifstrequal{#1}{F}%
    {\ufca@set{local@coadvisorgender}{a}}%
    {\ufca@set{local@coadvisorgender}{}}%
  \ufca@set{local@coadvisortitle}{#2}%
  \ufca@set{local@coadvisorname}{#3}%
  \ufca@set{local@coadvisordegree}{#4}}

\newcount\@examiner \@examiner=0
\newcommand\avaliador[4]{%
  \ufca@set{UfcaExaminerTitle:\the\@examiner}{#1}%
  \ufca@set{UfcaExaminerName:\the\@examiner}{#2}%
  \ufca@set{UfcaExaminerDegree:\the\@examiner}{#3}%
  \ufca@set{UfcaExaminerAffiliation:\the\@examiner}{#4}%
  \global\advance\@examiner by 1}

\newcounter{keywords}
\newcommand\palavrachave[1]{%
  \ufca@set{UfcaKeyword:\the\c@keywords}{#1}%
  \global\addtocounter{keywords}{1}}
\newcounter{foreignkeywords}
\newcommand\keyword[1]{%
  \ufca@set{UfcaForeignKeyword:\the\c@foreignkeywords}{#1}%
  \global\addtocounter{foreignkeywords}{1}}

%% ------------------------------------------------------------------
%% 7. Estrutura do documento
%% ------------------------------------------------------------------
\renewcommand\frontmatter{%
  \cleardoublepage
  \@mainmatterfalse
  % ABNT: a contagem inicia na folha de rosto (pagina 2, apos a capa),
  % mas os numeros nao sao impressos na parte pre-textual.
  \pagenumbering{roman}
  \thispagestyle{empty}
  \setcounter{page}{2}
  \makefrontpage
  \clearpage
  \pagestyle{empty}
  \ifcataloging@file
    \includepdf[pages=1]{\local@catalogingfile}
  \else
    \vspace*{\fill}
    \noindent\rule{\textwidth}{0.5pt}\par
    \noindent\begin{center}
      Página reservada para ficha catalográfica.\par
      Para solicitar a ficha catalográfica, envie seu trabalho acadêmico em PDF para:\par
      \url{catalogacao.sibi@ufca.edu.br}\par
    \end{center}\par
    \noindent\rule{\textwidth}{0.5pt}\par
  \fi
  \clearpage
  \makeapprovalpage
  \clearpage
  % Capitulos pre-textuais: titulo centralizado, negrito, caixa alta.
  % O recuo extra acima alinha o titulo das listas e do sumario com o
  % dos demais pre-textuais (agradecimentos, resumo), que sao compostos
  % sem \chapter*.
  \titlespacing*{\chapter}{1pt}{-\topskip-9.64pt}{\baselineskip+2pt}
  \titleformat{\chapter}[block]
    {\normalfont\bfseries\centering}
    {\normalfont\bfseries}
    {0pt}
    {\MakeUppercase}}

\renewcommand\mainmatter{%
  \ufca@mainBegin
  \cleardoublepage
  \@mainmattertrue
  \pagestyle{plain}
  % A contagem continua a das pre-textuais (nao ha \pagenumbering aqui,
  % de proposito); apenas a exibicao passa a ser em arabicos.
  \def\thepage{\arabic{page}}%
  \titlespacing*{\chapter}{1pt}{-1.8\topskip}{\baselineskip}
  \titleformat{\chapter}[block]
    {\normalfont\bfseries}
    {\normalfont\bfseries\thechapter~}
    {0pt}
    {\MakeUppercase}
  \titlespacing*{\section}{1pt}{\baselineskip}{\baselineskip}
  \titleformat{\section}[block]
    {\normalfont\bfseries}
    {\normalfont\bfseries\thesection~}
    {0pt}
    {}
  \titlespacing*{\subsection}{1pt}{\baselineskip}{\baselineskip}
  \titleformat{\subsection}[block]
    {\normalfont}
    {\normalfont\thesubsection~}
    {0pt}
    {}
  \titlespacing*{\subsubsection}{1pt}{\baselineskip}{\baselineskip}
  \titleformat{\subsubsection}[block]
    {\normalfont\itshape}
    {\normalfont\itshape\thesubsubsection~}
    {0pt}
    {}
  \titlespacing*{\paragraph}{1pt}{\baselineskip}{\baselineskip}
  \titleformat{\paragraph}[block]% quinario: titulo sublinhado (NBR 14724)
    {\normalfont}
    {\normalfont\theparagraph~}
    {0pt}
    {\uline}}

\renewcommand\backmatter{%
  \if@openright
    \cleardoublepage
  \else
    \clearpage
  \fi
  \titlespacing*{\chapter}{1pt}{-\topskip}{\baselineskip}
  \titleformat{\chapter}[block]
    {\normalfont\bfseries\centering}
    {\normalfont\bfseries}
    {0pt}
    {\MakeUppercase}}

