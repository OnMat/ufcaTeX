    \includepdf[pages=1]{\local@validationfile}
  \else
    \chapter{DECLARAÇÃO DE VALIDAÇÃO}
    \vspace*{\fill}
    \noindent\rule{\textwidth}{0.5pt}\par
    \noindent\begin{center}
      Página reservada para a Declaração de Validação.\par
      Ela deverá ser assinada pelo(a) professor(a) orientador(a) e anexada ao trabalho, com a finalidade de atestar que o trabalho se encontra em sua versão final, em conformidade com as alterações sugeridas pela banca examinadora. O documento certifica, ainda, que o(a) estudante realizou a revisão final do conteúdo textual e da formatação, atendendo às normas acadêmicas vigentes.\par
    \end{center}\par
    \noindent\rule{\textwidth}{0.5pt}\par
  \fi
}
