  \par{\centering
  \nohyphens{\bfseries\MakeUppercase{\@authname}}\par
  \vspace*{95.2mm}
  \nohyphens{\bfseries\MakeUppercase{\local@title}}\par}
  \begingroup
  \vspace*{\baselineskip}
  \raggedleft
  \singlespacing
  \begin{minipage}{80mm}
  \frontcover@maintext\par
