%% ------------------------------------------------------------------
%% 10. Sumario e listas (tocloft)
%% ------------------------------------------------------------------
%% NOTA: com a opcao [titles] do tocloft, os titulos das listas sao
%% compostos pelo \chapter* (via titlesec); os comandos \cft*title*
%% do tocloft nao teriam efeito. Por isso as listas sao definidas
%% abaixo com um unico auxiliar, que tambem remove o numero da pagina.
\newcommand*\ufca@listof[2]{%
  % #1 = extensao do arquivo (toc, lof, lot, loq); #2 = titulo
  \if@twocolumn
    \@restonecoltrue\onecolumn
  \else
    \@restonecolfalse
  \fi
  \chapter*{#2}%
  \thispagestyle{empty}%
  \@mkboth{\MakeUppercase{#2}}{\MakeUppercase{#2}}%
  \@starttoc{#1}%
  \if@restonecol\twocolumn\fi}

\renewcommand\tableofcontents{%
  \begingroup
    % Mede cada indicativo composto, para fixar a coluna de titulos
    % (NBR 6027:2012, item 5.2) na proxima compilacao
    \let\ufca@numberline\numberline
    \def\numberline##1{\ufca@tocmeasure{##1}\ufca@numberline{##1}}%
    \ufca@listof{toc}{\contentsname}%
  \endgroup}
\renewcommand\listoffigures{\ufca@hasLof\ufca@listof{lof}{\listfigurename}}
\renewcommand\listoftables{\ufca@listof{lot}{\listtablename}}
\let\sumario\tableofcontents
\let\listadefiguras\listoffigures
\let\listadetabelas\listoftables

% ---------- Sumario: fontes por nivel ----------
\renewcommand{\cftchapfont}{\bfseries}          % 1 INTRODUCAO
\renewcommand{\cftchappagefont}{\normalfont}
\renewcommand{\cftsecfont}{\bfseries}           % 2.1 negrito
\renewcommand{\cftsecpagefont}{\normalfont}
\renewcommand{\cftsubsecfont}{\normalfont}      % 2.1.1 normal
\renewcommand{\cftsubsubsecfont}{\itshape}      % 2.1.1.1 italico
\renewcommand{\cftsubsubsecpagefont}{\normalfont}
\renewcommand{\cftparafont}{\normalfont}        % quinario: sublinhado vem da propria entrada (\ufca@tocul)

% Pontilhado tambem nos capitulos (por padrao eles nao tem)
% Margem direita reservada nas entradas do sumario e das listas. O
% padrao do LaTeX (\@tocrmarg = 2,55 em) encurta TODAS as linhas da
% entrada para reservar espaco ao numero de pagina; o modelo da
% biblioteca so o reserva na ultima linha, usando tabulacao. Com 0pt,
% o texto vai ate a margem e o numero e empurrado pelo pontilhado,
% reproduzindo a mesma quebra de linha.
\cftsetrmarg{0pt}

% Largura da caixa do numero de pagina. O padrao (1,55 em) e largo
% demais para numeros de dois digitos, e a sobra vira um vao entre o
% pontilhado e o numero. Aqui a caixa e medida pelo maior numero de
% pagina do documento, mais a folga opcional \pontilhadosep.
% A ultima pagina e transportada pelo .aux, como \ultimafigura e as
% demais medidas da classe (usar \pageref aqui acionaria o hyperref
% antes de ele estar pronto).
\newlength{\ufca@pnumwd}
\newlength{\pontilhadosep}
\setlength{\pontilhadosep}{0pt}
\providecommand{\ultimapagina}{999}
\AtEndDocument{%
  \immediate\write\@auxout{\string\gdef\string\ultimapagina{\arabic{page}}}}
\AtBeginDocument{%
  \settowidth{\ufca@pnumwd}{\normalfont\ultimapagina}%
  \addtolength{\ufca@pnumwd}{\pontilhadosep}%
  \cftsetpnumwidth{\ufca@pnumwd}}

% Pontilhado denso (o padrao do tocloft, 4.5, e tres vezes mais esparso
% que o do modelo da biblioteca)
\renewcommand{\cftdotsep}{0}
\renewcommand{\cftchapleader}{\normalfont\cftdotfill{\cftdotsep}}
\renewcommand{\cftchapdotsep}{\cftdotsep}

% Sem o espaco vertical extra antes de cada capitulo
\setlength{\cftbeforechapskip}{0pt}

% ---------- Sumario: alinhamento conforme NBR 6027:2012 ----------
%% Indicativos de todos os niveis alinhados a esquerda (item 5.2, com
%% a NBR 6024) e titulos alinhados numa unica coluna, pela margem do
%% indicativo mais extenso, inclusive os elementos pos-textuais.
%% A largura da coluna e medida durante a composicao do sumario e
%% transportada pelo .aux (mesmo mecanismo das listas de figuras);
%% os numwidths sao fixados no \AtBeginDocument adiante.
%% Compile duas ou tres vezes ate estabilizar.
\setlength{\cftchapindent}{0pt}
\setlength{\cftsecindent}{0pt}
\setlength{\cftsubsecindent}{0pt}
\setlength{\cftsubsubsecindent}{0pt}
\setlength{\cftparaindent}{0pt}
\newlength{\ufca@tocmaxwd}% maior indicativo visto nesta compilacao
\newlength{\ufca@entrywd}
% Separacao entre o indicativo mais extenso e a coluna de titulos;
% ajustavel no preambulo com \setlength{\sumarionumsep}{...}
\newlength{\sumarionumsep}
\setlength{\sumarionumsep}{0.35em}% da ordem de um espaco de caractere
\newcommand*\ufca@tocmeasure[1]{%
  \settowidth{\ufca@entrywd}{\@cftbsnum #1\@cftasnum}%
  \ifdim\ufca@entrywd>\ufca@tocmaxwd
    \global\ufca@tocmaxwd=\ufca@entrywd
  \fi}

% ---------- Secoes quinarias: titulo sublinhado no sumario ----------
%% O sublinhado nao pode vir de \cftparafont (as fontes do tocloft sao
%% declarativas, e \uline exige argumento); em vez disso, o titulo ja
%% entra sublinhado no .toc, envolvido pelo robusto \ufca@tocul. No
%% texto, o sublinhado vem do \titleformat de \paragraph (secao 7),
%% garantindo grafia identica no sumario e no texto (NBR 14724).
\DeclareRobustCommand{\ufca@tocul}[1]{\uline{#1}}
\AtBeginDocument{%
  \NewCommandCopy\ufca@paragraph\paragraph
  \RenewDocumentCommand\paragraph{s o m}{%
    \IfBooleanTF{#1}%
      {\ufca@paragraph*{#3}}%
      {\IfNoValueTF{#2}%
        {\ufca@paragraph[{\ufca@tocul{#3}}]{#3}}%
        {\ufca@paragraph[{\ufca@tocul{#2}}]{#3}}}}%
  % Nos bookmarks do PDF (texto puro), o sublinhado e descartado
  \@ifpackageloaded{hyperref}{%
    \pdfstringdefDisableCommands{%
      \let\uline\@firstofone
      \let\ufca@tocul\@firstofone}}{}%
}

% Profundidade: ate o nivel quinario
\setcounter{tocdepth}{4}
\setcounter{secnumdepth}{4}

% ---------- Figuras e tabelas: numeracao continua e entradas ----------
\counterwithout{figure}{chapter}
