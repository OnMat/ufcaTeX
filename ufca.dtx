        \csname UfcaExaminerName:\the\count1\endcsname\ \ \ }\\
      \vskip3\p@ \baselineskip12pt
      \eqmakebox[signture@list][c]{%
        \ \ \ \protect\csname UfcaExaminerAffiliation:\the\count1 \endcsname\ \ \ }\\
      \advance\count1 by 1}%
