      \local@coadvisortitle\space\local@coadvisordegree\space
      \local@coadvisorname.}\par
  \fi
  \end{minipage}\par
  \endgroup
  \vspace*{\fill}
  \begin{center}
  \bfseries\MakeUppercase{\local@cityname}\par
  \local@year
  \end{center}}

\newcommand\makeapprovalpage{%
  \begingroup
  \centering
    {\bfseries\MakeUppercase{\@authname}}\par
    \vspace*{\fill}
    \sloppy\nohyphens{\bfseries\MakeUppercase{\local@title}}\par
  \endgroup
  \vspace*{\baselineskip}
  \begingroup
  \raggedleft
  \begin{minipage}{80mm}
  {\singlespacing
