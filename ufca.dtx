% \begin{abstract}
%   A classe \textsf{ufca} formata trabalhos de conclusão de curso,
%   dissertações e teses da Universidade Federal do Cariri segundo as
%   normas da ABNT e o manual de normalização da Biblioteca da UFCA.
%   O objetivo é que o autor se concentre no texto: margens,
%   entrelinhas, numeração de páginas, sumário, listas e referências
%   são tratados pela classe. Este documento descreve a interface de
%   uso e, na segunda parte, a implementação comentada.
% \end{abstract}
%
% \tableofcontents
%
% \section{Introdução}
%
% Escrever um trabalho acadêmico em \LaTeX{} seria simples se não
% fosse preciso atender, simultaneamente, a um conjunto de normas da
% ABNT e às exigências do manual de normalização da instituição. A
% classe \textsf{ufca} existe para absorver esse trabalho.
%
% A classe deriva do projeto \textsf{coppe}, da UFRJ, mas foi
% inteiramente reescrita: a interface passou a ser em português, as
% listas e o sumário foram reformulados segundo a
% \mbox{NBR 6027:2012}, e o modelo visual foi aferido, página a
% página, contra o \emph{template} em Word distribuído pela
% Biblioteca da UFCA.
%
% \subsection{O que a classe entrega}
%
% \begin{itemize}
%   \item capa, folha de rosto e folha de aprovação construídas a
%     partir dos dados declarados no preâmbulo;
%   \item numeração de páginas no canto superior direito, com a
%     contagem iniciando na folha de rosto e os números aparecendo
%     somente a partir da introdução;
%   \item sumário conforme a \mbox{NBR 6027:2012}, com os indicativos
%     alinhados à esquerda e os títulos numa única coluna;
%   \item listas de figuras, de tabelas, de abreviaturas e de
%     símbolos, com as colunas dimensionadas automaticamente;
%   \item referências pelo \textsf{biblatex} com o estilo
%     \textsf{abnt};
%   \item apêndices e anexos com rótulos e entradas de sumário
%     próprios.
% \end{itemize}
%
% \subsection{Requisitos}
%
% A classe exige um \LaTeX{} de 2020 ou posterior e os pacotes
% \textsf{biblatex} (com o estilo \textsf{abnt}), \textsf{tocloft},
% \textsf{titlesec}, \textsf{caption}, \textsf{geometry},
% \textsf{setspace}, \textsf{etoolbox}, \textsf{xpatch},
% \textsf{eqparbox}, \textsf{pdfpages} e \textsf{ulem}. A compilação
% da bibliografia usa o \textsf{biber}; as listas de abreviaturas e de
% símbolos usam o \textsf{makeindex} com o estilo \texttt{ufca.ist},
% distribuído junto com a classe.
%
% \section{Licença}
%
% Este programa é software livre: você pode redistribuí-lo e/ou
% modificá-lo sob os termos da Licença Pública Geral GNU, versão~3,
% publicada pela Free Software Foundation. Ele é distribuído na
% esperança de ser útil, mas \textsc{sem nenhuma garantia}. Veja o
% arquivo \texttt{LICENSE.md} para o texto completo.
%
% \section{Primeiros passos}
%
% O documento principal declara a classe, os dados do trabalho e a
% sequência das partes. O esqueleto mínimo é este:
%
% \begin{verbatim}
% \documentclass{ufca}
% \usepackage{amsmath,amssymb,amsthm}
% \usepackage{newtxtext,newtxmath}
% \usepackage{hyperref}
% \addbibresource{Referencias.bib}
%
% \begin{document}
%   \autor{Nome Completo do Estudante}
%   \titulo{Título do trabalho: subtítulo}
%   \unidadeacademica{Centro de Ciências e Tecnologia}
%   \curso{Matemática}
%   \grau{Bacharel}{Bacharelado}
%   \tipodetrabalho[true]{Trabalho de Conclusão de Curso}
%   \orientador{M}{Prof.}{Nome do Orientador}{Dr.}
%   \avaliador{Prof.}{Nome do Avaliador}{Dr.}{UFCA}
%   \local{Juazeiro do Norte}
%   \data{15}{dezembro}{2026}
%   \fichacatalografica{ficha.pdf}
%   \palavrachave{primeira palavra-chave}
%   \keyword{first keyword}
%
%   \maketitle
%   \frontmatter
%   \begin{agradecimentos} ... \end{agradecimentos}
%   \begin{resumo} ... \end{resumo}
%   \begin{abstract} ... \end{abstract}
%   \sumario
%   \listadefiguras
%   \mainmatter
%   \chapter{INTRODUÇÃO}
%     ...
%   \printbibliography
%   \appendix
%   \chapter{Questionário}
%   \annex
%   \chapter{Lei de acesso à informação}
%   \declaracaodevalidacao{validacao.pdf}
% \end{document}
% \end{verbatim}
%
% \subsection{Como compilar}
%
% Várias medidas da classe (largura dos rótulos das listas, coluna de
% títulos do sumário, largura da caixa do número de página) são
% tomadas numa compilação e aplicadas na seguinte, pelo arquivo
% \texttt{.aux}. Por isso, \textbf{duas ou três compilações} são
% necessárias para o resultado estabilizar. O \texttt{latexmk} cuida
% disso; com ele, basta
%
% \begin{verbatim}
% latexmk -pdf TCC.tex
% \end{verbatim}
%
% Se as listas de abreviaturas ou de símbolos forem usadas, é preciso
% ainda processar os arquivos auxiliares com o \textsf{makeindex} e o
% estilo \texttt{ufca.ist}; o \texttt{latexmkrc} distribuído com o
% \emph{template} já contém essas regras.
%
% \section{Dados do trabalho}
%
% Todos os comandos desta seção são declarados antes de
% |\maketitle|. Os dados em português têm comandos de nome português;
% o único campo que admite versão estrangeira (palavras-chave)
% usa o nome em inglês.
%
% \DescribeMacro{\autor}
% Recebe o nome completo do estudante, como deve aparecer na capa:
% |\autor{Maria da Silva}|.
%
% \DescribeMacro{\titulo}
% Define o título do trabalho, incluindo o subtítulo após dois-pontos:
% |\titulo{Título do trabalho: subtítulo}|. É esse título que aparece
% na capa, na folha de rosto, na folha de aprovação e nos metadados do
% PDF.
%
% \DescribeMacro{\unidadeacademica}
% Nome do centro ou da unidade acadêmica, por extenso.
%
% \DescribeMacro{\curso}
% \DescribeMacro{\programa}
% Use |\curso| para a graduação. A presença de |\programa| faz a
% classe tratar o trabalho como de pós-graduação, o que muda o
% texto da folha de rosto.
%
% \DescribeMacro{\grau}
% Recebe dois argumentos: o título conferido e o nível do curso, nesta
% ordem --- |\grau{Mestre}{Mestrado}|.
%
% \DescribeMacro{\tipodetrabalho}
% Recebe o tipo por extenso e, no argumento opcional, o gênero
% gramatical: |\tipodetrabalho[true]{Trabalho de Conclusão de Curso}|
% para masculino (``apresentado''), ou sem o opcional para feminino
% (``apresentada''), que é o padrão. O gênero concorda o texto da
% folha de rosto.
%
% \DescribeMacro{\local}
% \DescribeMacro{\data}
% |\local| é a cidade; |\data| recebe dia, mês por extenso e ano:
% |\data{15}{dezembro}{2026}|.
%
% \DescribeMacro{\orientador}
% \DescribeMacro{\coorientador}
% Ambos recebem quatro argumentos: gênero (|F| ou |M|), tratamento,
% nome e titulação --- |\orientador{F}{Profa.}{Ana Souza}{Dra.}|. O
% gênero flexiona ``Orientador''/``Orientadora''. O |\coorientador| é
% opcional; se ausente, a linha correspondente não é composta.
%
% \DescribeMacro{\avaliador}
% Pode ser chamado quantas vezes forem necessárias, uma por membro da
% banca, na ordem em que devem aparecer. Recebe tratamento, nome,
% titulação e instituição.
%
% \DescribeMacro{\palavrachave}
% \DescribeMacro{\keyword}
% Uma chamada por palavra-chave, na ordem desejada. |\palavrachave|
% alimenta o resumo; |\keyword|, o \emph{abstract}. A classe compõe a
% lista separada por ponto e vírgula e encerrada por ponto, e também
% preenche os metadados do PDF quando o \textsf{hyperref} está
% carregado.
%
% \DescribeMacro{\fichacatalografica}
% \DescribeMacro{\declaracaodevalidacao}
% Recebem o nome de um arquivo PDF de uma página, que é inserido no
% lugar devido. Se não forem declarados, a classe imprime no lugar uma
% página com as instruções para solicitar o documento.
%
% \section{Estrutura do documento}
%
% \DescribeMacro{\maketitle}
% \DescribeMacro{\frontmatter}
% \DescribeMacro{\mainmatter}
% Compõem, respectivamente, a capa; a parte pré-textual (folha de
% rosto, ficha, folha de aprovação e o que vier em seguida); e a parte
% textual. Devem ser chamados nesta ordem.
%
% A numeração de páginas segue a ABNT: a contagem começa na folha de
% rosto, mas os números só passam a ser impressos na primeira página
% da parte textual. |\mainmatter| não reinicia o contador --- apenas
% troca a exibição de algarismos romanos para arábicos.
%
% \subsection{Seções}
%
% A classe formata cinco níveis, com grafias distintas, idênticas no
% texto e no sumário:
%
% \begin{center}
% \small
% \begin{tabular}{lll}
%   \toprule
%   Nível & Comando & Grafia\\
%   \midrule
%   primário   & |\chapter|       & caixa alta, negrito\\
%   secundário & |\section|       & caixa alta e baixa, negrito\\
%   terciário  & |\subsection|    & caixa alta e baixa, normal\\
%   quaternário& |\subsubsection| & itálico\\
%   quinário   & |\paragraph|     & sublinhado\\
%   \bottomrule
% \end{tabular}
% \end{center}
%
% Os títulos de capítulo devem ser digitados já em caixa alta.
%
% \section{Elementos pré-textuais}
%
% \DescribeMacro{\dedicatoria}
% \DescribeMacro{\epigrafe}
% |\dedicatoria| recebe o texto; |\epigrafe| recebe o texto e a
% autoria, nesta ordem. Ambos compõem o bloco recuado à direita, sem
% título.
%
% \DescribeEnv{agradecimentos}
% \DescribeEnv{resumo}
% \DescribeEnv{abstract}
% Ambientes com título próprio. O |resumo| e o |abstract| acrescentam
% automaticamente, ao final, a lista de palavras-chave declarada com
% |\palavrachave| e |\keyword|.
%
% \section{Sumário e listas}
%
% \DescribeMacro{\sumario}
% \DescribeMacro{\listadefiguras}
% \DescribeMacro{\listadetabelas}
% \DescribeMacro{\listadeabreviaturas}
% \DescribeMacro{\listadesimbolos}
% Compõem o sumário e as listas, cada um começando em página nova e
% sem número de página impresso. São sinônimos em português de
% |\tableofcontents|, |\listoffigures| e |\listoftables|.
%
% \DescribeMacro{\abreviatura}
% \DescribeMacro{\simbolo}
% Registram uma entrada nas listas de abreviaturas e de símbolos:
% |\abreviatura{ABNT}{Associação Brasileira de Normas Técnicas}|. Para
% que os arquivos auxiliares sejam gerados, é preciso declarar
% |\geralistadeabreviaturas| e |\geralistadesimbolos| no preâmbulo.
%
% As entradas dessas duas listas não levam número de página: a página
% ainda é gravada no arquivo bruto, porque o \textsf{makeindex}
% precisa dela para ordenar e fundir entradas repetidas, mas é
% descartada na composição.
%
% \section{Ilustrações e tabelas}
%
% \DescribeMacro{\legenda}
% \DescribeMacro{\fonte}
% |\legenda| compõe o título da ilustração ou tabela, acima do objeto;
% |\fonte| compõe a indicação de fonte, abaixo. A fonte é obrigatória
% pela \mbox{NBR 14724}, mesmo quando o material é de autoria própria.
% |\source| é sinônimo de |\fonte|.
%
% Figuras e tabelas têm numeração contínua ao longo do trabalho, sem
% reiniciar a cada capítulo.
%
% \section{Referências}
%
% As referências são compostas pelo \textsf{biblatex} com o estilo
% \textsf{abnt}. Declare a base com |\addbibresource| no preâmbulo e
% chame |\printbibliography| onde as referências devem aparecer: a
% classe cuida do título, da entrada no sumário e do espaçamento.
%
% \section{Apêndices e anexos}
%
% \DescribeMacro{\appendix}
% \DescribeMacro{\annex}
% Depois de |\appendix|, cada |\chapter| passa a ser composto como
% ``APÊNDICE A -- Título''; depois de |\annex|, como ``ANEXO A --
% Título''. A numeração reinicia em~A em cada um dos dois, e as
% entradas correspondentes do sumário são geradas automaticamente.
% Apêndices são produzidos pelo autor; anexos, por terceiros.
%
% \section{Opções da classe}
%
% A classe não possui opções. Ela é sempre carregada com
% |\documentclass{ufca}|; qualquer opção informada produz um aviso de
% classe e é ignorada. O corpo do texto fica em 12\,pt, papel A4,
% entrelinhas de 1,5 linha e margens de 3\,cm à esquerda e no topo,
% 2\,cm à direita e embaixo, conforme a \mbox{NBR 14724}.
%
% \section{Parâmetros ajustáveis}
%
% Os valores a seguir reproduzem o modelo da Biblioteca da UFCA e
% normalmente não precisam ser alterados. Quando for necessário,
% redefina-os no preâmbulo, depois de |\documentclass|.
%
% \begin{center}
% \begin{tabular}{lll}
%   \toprule
%   Parâmetro & Padrão & Governa\\
%   \midrule
%   |\espacotitulo|    & \texttt{.98\string\baselineskip} & espaço entre o título dos
%                                                 pré-textuais e o texto\\
%   |\referenciassep|  & \texttt{0pt}        & espaço entre as referências\\
%   |\sumarionumsep|   & \texttt{0.35em}     & folga após o indicativo, no sumário\\
%   |\listanumsep|     & \texttt{0.32cm}     & folga após o travessão, nas listas\\
%   |\glossarioindent| & \texttt{1.25cm}     & coluna das definições\\
%   |\glossariosep|    & \texttt{1em}        & separação mínima rótulo--definição\\
%   |\pontilhadosep|   & \texttt{0pt}        & folga antes do número de página\\
%   \bottomrule
% \end{tabular}
% \end{center}
%
% O |\espacotitulo| é um comando, e não um comprimento, para que o
% |\baselineskip| seja avaliado no momento do uso, já com o fator de
% espaçamento da classe aplicado. Os demais são comprimentos e se
% ajustam com |\setlength|.
%
% \section{Conformidade com as normas}
%
% Algumas decisões da classe merecem registro, por não serem óbvias e
% por decorrerem de leitura direta das normas.
%
% \paragraph{Sumário (NBR 6027:2012).} O item~5.2 determina que os
% indicativos sejam alinhados à esquerda e que os títulos acompanhem a
% margem do indicativo mais extenso. A classe não usa, portanto,
% indentação progressiva por nível: mede o indicativo mais longo do
% documento e alinha todos os títulos numa única coluna, inclusive os
% dos elementos pós-textuais.
%
% \paragraph{Ilustrações (NBR 14724:2024).} O item~5.8 passou a exigir
% que tipo, número, título, fonte e notas acompanhem as margens da
% ilustração. A exigência poderia ser satisfeita para ilustrações que
% caibam numa página, mas não para tabelas que se estendam por
% várias: um objeto repartido entre páginas não possui uma largura. O
% item~5.9, que trata de tabelas, não repete a cláusula e remete às
% normas de apresentação tabular do IBGE, que preveem expressamente a
% tabela que ultrapassa a página.
%
% \paragraph{Referências (NBR 6023:2018).} A norma pede referências em
% espaço simples, separadas entre si por uma linha em branco. O padrão
% da classe é compacto; para seguir a norma à risca, use
% |\setlength{\referenciassep}{\baselineskip}|.
%
% \StopEventually{\PrintChanges\PrintIndex}
%
% \section{Implementação}
%
% O que segue é o código da classe. Os comentários aqui presentes são
% suprimidos do arquivo |ufca.cls| gerado; eles existem para quem lê
% esta documentação.
%
%    \begin{macrocode}
