  \@ifpackageloaded{hyperref}{\ufca@hypersetup}{}%
  \begin{titlepage}
  \noindent\begin{center}
  \makebox[30mm][c]{\includegraphics[scale=0.6027]{ufca-logo}}\par
  \vspace*{4.45mm}
  \textbf{\MakeUppercase{\local@universityname}}\par
  \textbf{\MakeUppercase{\local@unitname}}\par
  \ifposgrad
    \textbf{\MakeUppercase{\local@progname}}%
  \else
    \textbf{CURSO DE \MakeUppercase{\local@coursename}}%
  \fi\par
  \vspace*{7.3mm}
  \textbf{\nohyphens{\MakeUppercase{\@authname}}}\par
  \vspace*{58.26mm}
  \textbf{\nohyphens{\MakeUppercase{\local@title}}}\par
  \end{center}
  \vspace*{\fill}
  \begin{center}
  \textbf{\MakeUppercase{\local@cityname}}\par
