\setlength{\cfttabindent}{0pt}

% ---------- Largura das caixas de rotulo ("Figura 99 -- ") ----------
%% Medida com o maior numero da compilacao anterior, transportado pelo
%% .aux; na primeira compilacao valem os padroes dos \providecommand.
\newlength{\ufca@numwidth}
% Folga entre o travessao do rotulo ("Figura 9 -- ") e o titulo da
% entrada, nas listas de figuras e tabelas. O modelo da biblioteca usa
% tabulacao; este comprimento reproduz a mesma coluna.
\newlength{\listanumsep}
\setlength{\listanumsep}{0.32cm}
\newcommand*\ufca@setnumwidth[3]{%
  % #1 = prefixo, #2 = numero modelo, #3 = comprimento de destino
  \settowidth{\ufca@numwidth}{\bfseries #1 #2\space\textendash\space}%
  \addtolength{\ufca@numwidth}{\listanumsep}%
  \setlength{#3}{\ufca@numwidth}}
\providecommand{\ultimafigura}{99}
\providecommand{\ultimatabela}{99}
\providecommand{\ultimoindicativo}{}% largura do maior indicativo (com unidade)
\AtEndDocument{%
  \immediate\write\@auxout{\string\gdef\string\ultimafigura{\thefigure}}%
