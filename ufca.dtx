%% ------------------------------------------------------------------
%% 1. Identificacao e classe base
%% ------------------------------------------------------------------
\def\fileversion{v4.0}
\def\filedate{2026/11/06}
\NeedsTeXFormat{LaTeX2e}[2020/10/01]
\ProvidesClass{ufca}[\filedate\ \fileversion\ UFCA academic monographs]
\LoadClass[12pt,a4paper,oneside]{book}

%% ------------------------------------------------------------------
%% 2. Pacotes
%% ------------------------------------------------------------------
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}% redundante em kernels novos; inofensivo
\RequirePackage{setspace}
\RequirePackage{caption}
\RequirePackage{subcaption}
\RequirePackage{csquotes}
\RequirePackage[style=abnt,backend=biber]{biblatex}
\RequirePackage{hyphenat}
\RequirePackage[normalem]{ulem}% \uline com quebra de linha; normalem preserva \emph
\RequirePackage{graphicx}
\RequirePackage{tabularx}
\RequirePackage{booktabs}
\RequirePackage{pdfpages}
\RequirePackage{eqparbox}
\RequirePackage{multirow}
\RequirePackage{etoolbox}
\RequirePackage{xpatch}
\RequirePackage{url}% para \url na pagina da ficha catalografica sem hyperref
\RequirePackage[a4paper,bindingoffset=0.0cm,vcentering=true,%
  top=3cm,bottom=2cm,left=3cm,right=2cm,headsep=2.66\baselineskip]{geometry}
\RequirePackage[compact]{titlesec}
\RequirePackage[titles]{tocloft}
%% Mantidos apenas por compatibilidade com documentos existentes;
%% a classe em si nao os utiliza mais e eles podem ser removidos
%% numa versao futura:
\RequirePackage{ifthen}
\RequirePackage{lastpage}
\RequirePackage{indentfirst}
%% Obs.: o hyperref NAO e carregado pela classe; se desejado, deve ser
%% carregado pelo documento. Toda a integracao e condicional.

%% ------------------------------------------------------------------
%% 3. Chaves booleanas e opcoes de classe
%% ------------------------------------------------------------------
%% Todas as chaves booleanas usam \newif; as que recebem valor textual
%% (true/false) do usuario sao ajustadas via \ifstrequal (etoolbox).
\newif\ifmaledoc         \maledocfalse        % genero gramatical do tipo de trabalho
\newif\ifposgrad         \posgradfalse        % pos-graduacao (programa) ou graduacao (curso)
