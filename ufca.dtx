%% ------------------------------------------------------------------
%% 12. Bibliografia
%% ------------------------------------------------------------------
%% Rotulos gravados no .aux para uso na ficha catalografica e afins;
%% o formato depende da presenca do hyperref, por isso a definicao
%% e adiada para o inicio do documento.
\AtBeginDocument{%
  \@ifpackageloaded{hyperref}{%
    \def\ufca@bibEnd{%
      \immediate\write\@auxout{%
        \string\newlabel{bib:end}{{}{\arabic{page}}{}{page.\arabic{page}}{}}}}%
    \def\ufca@bibBegin{%
      \immediate\write\@auxout{%
        \string\newlabel{bib:begin}{{}{\arabic{page}}{}{page.\arabic{page}}{}}}}%
    \def\ufca@mainBegin{%
      \immediate\write\@auxout{%
        \string\newlabel{front:pageno}{{}{\Roman{page}}{}{page.\roman{page}}{}}}}%
    \def\ufca@hasLof{%
      \immediate\write\@auxout{%
        \string\newlabel{cat:lofflag}{{}{:~il.;}{}{page.\roman{page}}{}}}}%
  }{%
    \def\ufca@bibEnd{%
      \immediate\write\@auxout{%
        \string\newlabel{bib:end}{{}{\arabic{page}}{}}}}%
    \def\ufca@bibBegin{%
      \immediate\write\@auxout{%
        \string\newlabel{bib:begin}{{}{\arabic{page}}{}}}}%
    \def\ufca@mainBegin{%
      \immediate\write\@auxout{%
        \string\newlabel{front:pageno}{{}{\Roman{page}}{}}}}%
    \def\ufca@hasLof{%
      \immediate\write\@auxout{%
        \string\newlabel{cat:lofflag}{{}{:~il.;}{}}}}%
  }%
  % Injeta inicio/fim e a entrada no sumario no \printbibliography,
  % preservando o argumento opcional do biblatex.
  \def\ufca@printbibliography[#1]{%
    \ufca@bibBegin
    \addcontentsline{toc}{chapter}{\numberline{}\MakeUppercase{\ufca@bibtitlename}}%
    \titlespacing*{\chapter}{1pt}{-1.8\topskip}{1.3\baselineskip}%
    \blx@printbibliography[title={\MakeUppercase{\ufca@bibtitlename}},#1]%
    \ufca@bibEnd}%
  \xpatchcmd{\printbibliography}%
    {{\blx@printbibliography}
      {\blx@printbibliography[]}}%
    {{\ufca@printbibliography}
      {\ufca@printbibliography[]}}%
    {}%
    {\ClassWarning{ufca}{Nao foi possivel adaptar \string\printbibliography:
      o titulo das referencias e a entrada no sumario podem sair fora do
      padrao. Verifique a versao do biblatex}}%
}

% Espaco vertical entre as referencias. A NBR 6023:2018 pede que elas
% sejam "separadas entre si por uma linha em branco de espaco simples",
% o que corresponde a \baselineskip; o padrao aqui e compacto. Ajuste
% no preambulo com \setlength{\referenciassep}{\baselineskip}.
% Prefira este comprimento a \bibitemsep: o valor e aplicado no inicio
% do documento, depois do preambulo, e sobrescreveria um \bibitemsep
% definido la.
\newlength{\referenciassep}
\setlength{\referenciassep}{.6\baselineskip}
% O valor e lido aqui, na composicao da bibliografia, e nao por um
% gancho: o proprio biblatex executa "\setlength{\bibitemsep}{\itemsep}"
% ao carregar biblatex.def, o que em versoes recentes ocorre depois dos
% ganchos de inicio de documento e anularia qualquer ajuste feito la.
% Esta redefinicao reproduz o ambiente padrao do biblatex trocando
% apenas o \itemsep, e independe do \xpatchcmd adiante.
\defbibenvironment{bibliography}
  {\list{}%
     {\setlength{\leftmargin}{\bibhang}%
      \setlength{\itemindent}{-\leftmargin}%
      \setlength{\itemsep}{\referenciassep}%
      \setlength{\parsep}{\bibparsep}}}
  {\endlist}
  {\item}
% O valor e aplicado dentro de \ufca@printbibliography (secao abaixo),
% imediatamente antes de compor a bibliografia. Nao se usa aqui
% \AtBeginDocument porque o proprio biblatex executa
% "\setlength{\bibitemsep}{\itemsep}" ao carregar biblatex.def, o que
% em versoes recentes ocorre DEPOIS dos ganchos de inicio de documento
% e anula qualquer valor posto no preambulo; nem \AtBeginBibliography,
% que ja roda com a lista aberta, quando o \itemsep foi lido.

% Ambiente classico, para documentos que nao usem o biblatex
\setlength\bibindent{1.5em}
\renewenvironment{thebibliography}[1]%
     {\onehalfspacing
      \chapter*{\MakeUppercase{\bibname}}%
      \addcontentsline{toc}{chapter}{\numberline{}\MakeUppercase{\bibname}}%
      \ufca@bibBegin
      \list{\@biblabel{\@arabic\c@enumiv}}%
           {\setlength{\labelwidth}{0ex}%
            \setlength{\leftmargin}{9.0ex}%
            \setlength{\itemindent}{-9.0ex}%
            \advance\leftmargin\labelsep
            \@openbib@code
            \usecounter{enumiv}%
            \let\p@enumiv\@empty
            \renewcommand\theenumiv{\@arabic\c@enumiv}}%
      \sloppy
      \clubpenalty4000%
      \@clubpenalty \clubpenalty
      \widowpenalty4000%
      \sfcode`\.\@m}%
     {\def\@noitemerr%
       {\@latex@warning{Empty `thebibliography' environment}}%
      \ufca@bibEnd
      \endlist}

%% ------------------------------------------------------------------
%% 13. Abreviaturas, simbolos, glossario e indice
%% ------------------------------------------------------------------
\newcommand\listadeabreviaturas{%
  \begingroup
  \renewcommand\glossaryname{\listabbreviationname}%
  \def\ufca@glokey{lab}%
  \@input@{\jobname.lab}%
  \endgroup}
\def\geralistadeabreviaturas{%
  \newwrite\@labfile
  \immediate\openout\@labfile=\jobname.abx
  \def\abreviatura{\@bsphack\begingroup
              \@sanitize
              \@wrlab}\typeout
  {Writing index of abbreviations file \jobname.abx}%
  \let\geralistadeabreviaturas\@empty}
\@onlypreamble\geralistadeabreviaturas

\newcommand\listadesimbolos{%
  \begingroup
  \renewcommand\glossaryname{\listsymbolname}%
  \def\ufca@glokey{los}%
  \@input@{\jobname.los}%
  \endgroup}
\def\geralistadesimbolos{%
  \newwrite\@losfile
  \immediate\openout\@losfile=\jobname.syx
  \def\simbolo{\@bsphack\begingroup
             \@sanitize
             \@wrlos}\typeout
  {Writing index of symbols file \jobname.syx}%
  \let\geralistadesimbolos\@empty}
\@onlypreamble\geralistadesimbolos

% Gravadores das entradas. A pagina ainda e escrita no arquivo bruto
% (o makeindex precisa dela para ordenar e fundir entradas repetidas),
% mas o encapsulador \ufca@nopage a descarta na composicao: listas de
% abreviaturas e de simbolos nao levam numero de pagina. Os
% delimitadores correspondentes estao zerados em ufca.ist.
% Como a pagina nao e impressa, o hyperref e irrelevante aqui e os
% dois gravadores tem uma unica definicao.
\newcommand*\ufca@nopage[1]{}
\def\@wrlab#1#2{%
  \protected@write\@labfile{}%
    {\string\indexentry{[#1] #2|ufca@nopage}{\thepage}}%
  \endgroup
  \@esphack}
\def\@wrlos#1#2{%
  \protected@write\@losfile{}%
    {\string\indexentry{[#1] #2|ufca@nopage}{\thepage}}%
  \endgroup
  \@esphack}

% Coluna de rotulos medida automaticamente e POR LISTA: abreviaturas
% (lab), simbolos (los) e glossario (glo) tem colunas independentes,
% cada qual com a largura do seu rotulo mais extenso na compilacao
% anterior (via .aux). O texto das definicoes comeca \glossariosep
% depois da coluna.
\newlength{\ufca@labwd}
% Coluna das definicoes nas listas de abreviaturas, simbolos e no
% glossario. O modelo da biblioteca usa uma tabulacao fixa: a definicao
% comeca sempre a \glossarioindent da margem. Se algum rotulo for mais
% largo que isso, a coluna cresce e passa a valer \glossariosep como
% separacao minima entre rotulo e definicao.
\newlength{\glossarioindent}
\setlength{\glossarioindent}{1.25cm}
\newlength{\glossariosep}% separacao minima rotulo-definicao
\setlength{\glossariosep}{1em}
\newcommand*\ufca@glokey{glo}% chave da lista corrente
\newcommand*\ufca@setrotulo[2]{\global\@namedef{ultimorotulo:#1}{#2}}
\newcommand*\ufca@labmeasure[1]{%
  \ifcsundef{ufca@labmax@\ufca@glokey}%
    {\expandafter\newlength\csname ufca@labmax@\ufca@glokey\endcsname}{}%
  \settowidth{\ufca@labwd}{#1}%
  \ifdim\ufca@labwd>\csname ufca@labmax@\ufca@glokey\endcsname
    \global\csname ufca@labmax@\ufca@glokey\endcsname=\ufca@labwd
  \fi}
\AtEndDocument{%
  \def\ufca@wrrotulo#1{%
    \ifcsundef{ufca@labmax@#1}{}{%
      \immediate\write\@auxout{\string\ufca@setrotulo{#1}%
        {\expandafter\the\csname ufca@labmax@#1\endcsname}}}}%
  \ufca@wrrotulo{lab}\ufca@wrrotulo{los}\ufca@wrrotulo{glo}%
}

\newenvironment{theglossary}{%
  \if@twocolumn
    \@restonecoltrue\onecolumn
  \else
    \@restonecolfalse
  \fi
  \@mkboth{\MakeUppercase\glossaryname}%
          {\MakeUppercase\glossaryname}%
  \chapter*{\glossaryname}%
  % Sem numero de pagina nos usos pre-textuais (listas de abreviaturas
  % e de simbolos); o glossario, pos-textual, permanece numerado.
  \if@mainmatter\else\thispagestyle{empty}\fi
  % alinha a 1a entrada com a 1a linha das demais listas (o \topsep da
  % \list seria absorvido pelo espaco do titulo, que e maior)
  \vspace*{-2pt}%
  \list{}
  {\setlength{\listparindent}{0in}%
   \ifcsvoid{ultimorotulo:\ufca@glokey}%
     {\setlength{\labelwidth}{5em}}% chute da primeira compilacao
     {\setlength{\labelwidth}{\csname ultimorotulo:\ufca@glokey\endcsname}}%
   % coluna fixa de \glossarioindent, salvo se o rotulo nao couber
   \setlength{\labelsep}{\glossarioindent}%
   \addtolength{\labelsep}{-\labelwidth}%
   \ifdim\labelsep<\glossariosep \setlength{\labelsep}{\glossariosep}\fi
   \setlength{\leftmargin}{\labelwidth}%
   \addtolength{\leftmargin}{\labelsep}%
   \setlength{\itemindent}{0in}%
   % Rotulos (siglas/simbolos) alinhados a esquerda da caixa de rotulo
   % (o padrao do kernel, \hfil #1, os alinha a direita); de passagem,
   % cada rotulo e medido para fixar a coluna na proxima compilacao
   \renewcommand{\makelabel}[1]{\ufca@labmeasure{##1}##1\hfil}%
   % Espacamento entre itens identico ao entrelinhas do texto:
   % sem os acrescimos verticais padrao das listas
   \setlength{\itemsep}{0pt}%
   \setlength{\parsep}{0pt}%
   \setlength{\topsep}{0pt}%
   \setlength{\partopsep}{0pt}}%
   \sloppy}%
  {\if@restonecol\twocolumn\fi
   \endlist}

\renewenvironment{theindex}{%
  \if@twocolumn
    \@restonecolfalse
  \else
    \@restonecoltrue
  \fi
  \twocolumn[\@makeschapterhead{\indexname}]%
  \@mkboth{\MakeUppercase\indexname}%
          {\MakeUppercase\indexname}%
  \thispagestyle{plain}\parindent\z@
  \addcontentsline{toc}{chapter}{\numberline{}\indexname}%
  \parskip\z@ \@plus .3\p@\relax
  \columnseprule \z@
  \columnsep 35\p@
  \let\item\@idxitem}
  {\if@restonecol\onecolumn\else\clearpage\fi}

%% ------------------------------------------------------------------
%% 14. Apendices e anexos
%% ------------------------------------------------------------------
\renewcommand\appendix{\par
  \setcounter{chapter}{0}%
  \setcounter{section}{0}%
  \gdef\@chapapp{\appendixname}%
  \gdef\thechapter{\@Alph\c@chapter}%
  \titlespacing*{\chapter}{1pt}{-1.8\topskip}{\baselineskip}%
  \titleformat{\chapter}[block]
    {\normalfont\bfseries\centering}
    {\normalfont\bfseries APÊNDICE~\thechapter~--~}
    {0pt}
    {\MakeUppercase}}

\newcommand\annex{\par
  \setcounter{chapter}{0}%
  \setcounter{section}{0}%
  \gdef\thechapter{\@Alph\c@chapter}%
  % Prefixo distinto nas ancoras do hyperref, para nao colidir com as
  % dos apendices (ambos reiniciam a contagem em "A")
  \gdef\theHchapter{annex.\@Alph\c@chapter}%
  \titlespacing*{\chapter}{1pt}{-1.8\topskip}{\baselineskip}%
  \titleformat{\chapter}[block]
    {\normalfont\bfseries\centering}
    {\normalfont\bfseries ANEXO~\thechapter~--~}
    {0pt}
    {\MakeUppercase}}

% Dentro de \appendix/\annex, o \chapter passa a compor o titulo com
% o rotulo completo ("APENDICE A -- ...") e a registrar a entrada no
% sumario manualmente. A troca e adiada para o inicio do documento
% para capturar a versao final de \chapter.
\newcommand\appendix@chapter[1]{%
  \refstepcounter{chapter}%
  \def\app@ct{APÊNDICE \@Alph\c@chapter\space--\space#1}%
  \orig@chapter*{\app@ct}%
  \markboth{\MakeUppercase{\app@ct}}{\MakeUppercase{\app@ct}}%
  \addcontentsline{toc}{chapter}{\numberline{}\app@ct}}
\newcommand\annex@chapter[1]{%
  \refstepcounter{chapter}%
  \def\app@ct{ANEXO \@Alph\c@chapter\space--\space#1}%
  \orig@chapter*{\app@ct}%
  \markboth{\MakeUppercase{\app@ct}}{\MakeUppercase{\app@ct}}%
  \addcontentsline{toc}{chapter}{\numberline{}\app@ct}}
\AtBeginDocument{%
  \let\orig@chapter\chapter
  \g@addto@macro\appendix{\let\chapter\appendix@chapter}%
  \g@addto@macro\annex{\let\chapter\annex@chapter}%
}

%% ------------------------------------------------------------------
%% 15. Integracao com hyperref
%% ------------------------------------------------------------------
\newcommand\ufca@hypersetup{%
\begingroup
  % Monta a lista de palavras-chave separadas por "; " em \toks@
  \toks@={}%
  \count@=0 %
  \@whilenum\count@<\value{keywords}\do{%
    \ifcase\count@ % primeira palavra-chave, sem separador
      \toks@=\expandafter{\csname UfcaKeyword:\the\count@\endcsname}%
    \else
      \toks@=\expandafter\expandafter\expandafter{%
        \expandafter\the\expandafter\toks@
        \expandafter;\expandafter\space
        \csname UfcaKeyword:\the\count@\endcsname
      }%
    \fi
    \advance\count@ by 1%
  }%
  \edef\x{\endgroup
    \noexpand\hypersetup{%
      pdfkeywords={\the\toks@}%
    }%
  }%
\x
\hypersetup{%
  pdfauthor={\@authname},
  pdftitle={\local@title},
  pdfsubject={\local@doctype\ de \local@levelname},
  pdfcreator={LaTeX with ufca class},
  breaklinks={true},
  raiselinks={true},
  pageanchor={true},
}}

